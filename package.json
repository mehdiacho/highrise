{
  "name": "richup",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,green \"pnpm --filter @richup/server dev\" \"pnpm --filter @richup/web dev\"",
    "test": "pnpm -r test",
    "test:engine": "pnpm --filter @richup/shared test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --ext .ts,.tsx --ignore-path .gitignore"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.3"
  }
}
